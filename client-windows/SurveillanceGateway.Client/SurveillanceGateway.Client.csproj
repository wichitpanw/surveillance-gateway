<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>SurveillanceGateway</AssemblyName>
    <!--
      The version Velopack stamps into a release. An installed client compares it against what
      the gateway is serving, so it has to go up for an update to be offered at all.
    -->
    <Version>1.9.8</Version>
    <!-- Generated by scripts/make-client-icon.py; edit that, not the .ico. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>SurveillanceGateway.Client</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!--
      libvlc finds its ~450-DLL plugins/ tree by path at runtime, so this can never be a
      single-file publish: that would extract to temp on every launch.
    -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also used as the window icon at runtime, so it has to ship, not only be compiled in. -->
    <Resource Include="Assets\app.ico" />
    <!-- The UI faces ship with the app; a client machine has none of them installed. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- The OFL requires its text to travel with the fonts: installed as Assets\Fonts\licenses. -->
    <Content Include="Assets\Fonts\licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
