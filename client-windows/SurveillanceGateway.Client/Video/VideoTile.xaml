<UserControl x:Class="SurveillanceGateway.Client.Video.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services">
    <Border x:Name="Frame"
            Background="{DynamicResource VideoGroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusControl}">
        <vlc:VideoView x:Name="Video">
            <!--
                Everything drawn here goes into VideoView's own transparent overlay window,
                which is the only surface that can sit above the video HWND. A WPF element
                placed over the VideoView in the visual tree would simply be painted under it.

                Painted opaque while nothing is playing. A WPF element behind the VideoView
                cannot cover its HWND - the empty cell would show the Win32 control grey - so
                the empty state is drawn in the overlay window, which is above it.

                Input is handled here too. A click lands on this window, so a handler on the tile
                itself is only ever reached while the cell is empty.
            -->
            <Grid x:Name="Overlay" Background="#000000">

                <!--
                    Where a dragged camera would land. Inside the overlay because the frame around
                    the cell is painted behind the video window: on a cell that is playing, a
                    border highlight is invisible exactly when the operator needs it.
                -->
                <!--
                    Not hit-testable: when it could take the pointer, appearing under the cursor
                    raised DragLeave on the overlay, which hid it, which raised DragEnter - the
                    marker flickered for as long as a camera was held over the cell.
                -->
                <Border x:Name="DropMarker"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Margin="2"
                        BorderBrush="{DynamicResource BrandYellowBrush}"
                        BorderThickness="2"
                        Background="#33F2C14E"
                        CornerRadius="{StaticResource Radius}"
                        Panel.ZIndex="5" />

                <!--
                    The selected cell. Drawn in the overlay for the same reason as the drop marker:
                    the tile's own frame is behind the video window, so on a playing cell the
                    operator could not see which cell a click in the camera list would fill.
                -->
                <Border x:Name="SelectMarker"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        BorderBrush="{DynamicResource BrandYellowBrush}"
                        BorderThickness="2"
                        Panel.ZIndex="4" />

                <!-- Name and state, top left, on a scrim so it stays readable over a bright scene. -->
                <Border x:Name="Caption"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="9"
                        Padding="9,5"
                        CornerRadius="{StaticResource Radius}"
                        Background="#B3060911">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="7" Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource FaintForegroundBrush}" />
                        <TextBlock x:Name="NameText"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5"
                                   Foreground="#E9ECF6"
                                   Text="{svc:T cell.empty}" />
                    </StackPanel>
                </Border>

                <Border x:Name="StatsChip"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="9"
                        Padding="8,4"
                        CornerRadius="{StaticResource Radius}"
                        Background="#B3060911">
                    <TextBlock x:Name="StatsText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10.5"
                               Foreground="#C9D2EA"
                               Text="" />
                </Border>

                <!--
                    Where the picture came from. This is the point of the whole client - most of
                    this fleet is H.265 and reaches the screen without an encoder on the server -
                    so it is stated per cell rather than buried in a detail page.
                -->
                <Border x:Name="CodecChip"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="9"
                        Padding="8,3"
                        CornerRadius="{StaticResource Radius}"
                        Background="#291A2544"
                        BorderBrush="#662E4380"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="CodecText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="#B9CCFF"
                               Text="" />
                </Border>

                <!--
                    The cell's own controls, bottom right, shown while the pointer is over it.

                    Visibility is a trigger on IsMouseOver, not a pair of MouseEnter/MouseLeave
                    handlers. Those handlers went out of step every time a cell restarted its
                    stream - the overlay is rebuilt under the pointer, no enter is raised, and the
                    controls stayed hidden until the pointer left the cell and came back. A
                    trigger reads the state instead of trying to track it.
                -->
                <StackPanel x:Name="CellControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="9">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- Both conditions: an empty cell has nothing these can do to it. -->
                                <!--
                                    Both bindings stay inside the overlay window: its DataContext
                                    is the tile (set in the code-behind), and the Grid ancestor is
                                    the overlay itself. An AncestorType=UserControl lookup finds
                                    nothing from here - this content is hosted in the VideoView's
                                    own window, not under the tile in the visual tree.
                                -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                                        <Condition Binding="{Binding HasCamera}" Value="True" />
                                        <Condition Binding="{Binding CellChrome}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button x:Name="StreamButton"
                            Style="{StaticResource TileButton}"
                            ToolTip="{svc:T cell.streamToggle}"
                            Content="{svc:T wall.streamSub}" />
                    <Button x:Name="ExpandButton"
                            Style="{StaticResource TileButton}"
                            Margin="6,0,0,0"
                            ToolTip="{svc:T cell.open}">
                        <Path Width="10" Height="10"
                              Stretch="Uniform"
                              Fill="{x:Null}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                              Data="M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15" />
                    </Button>
                    <Button x:Name="ClearButton"
                            Style="{StaticResource TileButton}"
                            Margin="6,0,0,0"
                            ToolTip="{svc:T cell.clear}">
                        <Path Width="10" Height="10"
                              Stretch="Uniform"
                              Fill="{x:Null}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                              Data="M5 5 L15 15 M15 5 L5 15" />
                    </Button>
                </StackPanel>

                <!--
                    The cell menu, drawn here rather than as a ContextMenu.

                    A WPF ContextMenu opens in a popup owned by the window its target belongs to,
                    and this content belongs to the VideoView's own overlay window - the menu never
                    appeared, whether WPF opened it or we did. A panel inside the overlay is drawn
                    by the same surface as the caption and the chips, which is known to work.
                -->
                <Border x:Name="CellMenu"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F20B0F1C"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="6"
                        Visibility="Collapsed">
                    <StackPanel MinWidth="190">
                        <Button x:Name="MenuOpen" Style="{StaticResource TileMenuItem}" Content="{svc:T cell.open}" />
                        <Button x:Name="MenuAssign" Style="{StaticResource TileMenuItem}" Content="{svc:T cell.assign}" />
                        <Border Height="1" Margin="8,5" Background="#26FFFFFF" />
                        <Button x:Name="MenuSub" Style="{StaticResource TileMenuItem}" Content="{svc:T cell.streamSub}" />
                        <Button x:Name="MenuMain" Style="{StaticResource TileMenuItem}" Content="{svc:T cell.streamMain}" />
                        <Border Height="1" Margin="8,5" Background="#26FFFFFF" />
                        <Button x:Name="MenuClear" Style="{StaticResource TileMenuItem}" Content="{svc:T cell.clear}" />
                    </StackPanel>
                </Border>

                <!-- A failed cell says what it is doing, rather than going black and silent. -->
                <Border x:Name="MessageBar"
                        VerticalAlignment="Bottom"
                        Background="#26F2685C"
                        BorderBrush="#4DF2685C"
                        BorderThickness="0,1,0,0"
                        Padding="11,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MessageText"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11.5"
                               Foreground="#FFC9C3"
                               TextTrimming="CharacterEllipsis"
                               Text="" />
                </Border>
            </Grid>
        </vlc:VideoView>
    </Border>
</UserControl>
