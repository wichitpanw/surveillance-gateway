<UserControl x:Class="SurveillanceGateway.Client.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="26,23,26,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T home.workspace}" />
                <TextBlock x:Name="GreetingText" FontFamily="{StaticResource DisplayFont}" FontSize="29"
                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock x:Name="SubText" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                <Border x:Name="BuildWarning" Visibility="Collapsed" Margin="0,12,0,0" Padding="11,8"
                        CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                        BorderBrush="{DynamicResource StatusWarnBrush}">
                    <TextBlock x:Name="BuildWarningText" Style="{StaticResource LabelText}"
                               Foreground="{DynamicResource StatusWarnBrush}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0,26,0,11" Text="{svc:T home.quickAccess}" />
                <Button x:Name="WallCard" Style="{StaticResource LandingCard}" Background="#263432" Padding="24" Height="252">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Width="88" Height="88" HorizontalAlignment="Right" VerticalAlignment="Top"
                                CornerRadius="22" Background="#344B47" Margin="0,0,15,0">
                            <Path Width="45" Height="45" Stretch="Uniform" Stroke="#A7E2CD" StrokeThickness="1.7"
                                  Data="M3 4 H11 V11 H3 Z M13 4 H21 V11 H13 Z M3 13 H11 V20 H3 Z M13 13 H21 V20 H13 Z" />
                        </Border>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A7E2CD" Text="{svc:T home.liveWorkspace}" />
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,12,0,0" Text="{svc:T shell.navWall}" />
                            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="#D1E0DB"
                                       TextWrapping="Wrap" MaxWidth="310" HorizontalAlignment="Left"
                                       Margin="0,8,0,0" Text="{svc:T home.wallBlurb}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="WallState" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="#C8DBD2" VerticalAlignment="Bottom" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="25"
                                       Foreground="#A7E2CD" Text="&#x2197;" />
                        </Grid>
                    </Grid>
                </Button>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="MapCard" Grid.Column="0" Style="{StaticResource LandingCard}"
                            Background="#314257" Margin="0,0,6,0" Padding="20" Height="213">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <Path Width="40" Height="40" HorizontalAlignment="Left" Stretch="Uniform"
                                      Stroke="#BED8F4" StrokeThickness="1.7"
                                      Data="M9 4 L15 6 L20 4 V18 L15 20 L9 18 L4 20 V6 Z M9 4 V18 M15 6 V20" />
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,15,0,0" Text="{svc:T shell.navMap}" />
                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#D7E3F0"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Text="{svc:T home.mapBlurb}" />
                            </StackPanel>
                            <TextBlock x:Name="MapState" Grid.Row="1" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="#D7E3F0" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                    <Button x:Name="DevicesCard" Grid.Column="1" Style="{StaticResource LandingCard}"
                            Background="#48406A" Margin="6,0,0,0" Padding="20" Height="213">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <Path Width="40" Height="40" HorizontalAlignment="Left" Stretch="Uniform"
                                      Stroke="#DCD3FB" StrokeThickness="1.7"
                                      Data="M3 6 H21 V12 H3 Z M3 14 H21 V19 H3 Z" />
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,15,0,0" Text="{svc:T shell.navDetail}" />
                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#E1DDF0"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Text="{svc:T home.devicesBlurb}" />
                            </StackPanel>
                            <TextBlock x:Name="DevicesState" Grid.Row="1" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="#E1DDF0" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="20,22">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T home.overview}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="19" Margin="0,5,0,0"
                               Text="{svc:T home.cameraHealth}" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,17,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.total}" />
                                <TextBlock x:Name="TotalFigure" FontFamily="{StaticResource DisplayFont}" FontSize="27"
                                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.online}" />
                                <TextBlock x:Name="OnlineFigure" FontFamily="{StaticResource DisplayFont}" FontSize="27"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,16,0,17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.offline}" />
                                <TextBlock x:Name="OfflineFigure" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusCritBrush}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.other}" />
                                <TextBlock x:Name="OtherFigure" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusWarnBrush}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource EyebrowText}" Margin="0,22,0,0" Text="{svc:T home.activity}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="16" Margin="0,5,0,0" Text="{svc:T home.events}" />
                    <TextBlock x:Name="FeedSub" Style="{StaticResource LabelText}" Margin="0,4,0,0" />
                    <ItemsControl x:Name="EventList" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="32" CornerRadius="2" Background="{Binding Accent}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0">
                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Camera}" />
                                        <TextBlock Style="{StaticResource LabelText}" FontSize="10.5" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="10" Text="{Binding At}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyFeed" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                               Margin="0,12,0,4" Text="{svc:T home.noEvents}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
