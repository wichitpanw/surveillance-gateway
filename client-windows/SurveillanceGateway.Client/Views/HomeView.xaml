<UserControl x:Class="SurveillanceGateway.Client.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CardState" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#DCE8F5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="26,23,26,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T home.workspace}" />
                <TextBlock x:Name="GreetingText" FontFamily="{StaticResource DisplayFont}" FontSize="29"
                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock x:Name="SubText" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                <Border x:Name="BuildWarning" Visibility="Collapsed" Margin="0,12,0,0" Padding="11,8"
                        CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                        BorderBrush="{DynamicResource StatusWarnBrush}">
                    <TextBlock x:Name="BuildWarningText" Style="{StaticResource LabelText}"
                               Foreground="{DynamicResource StatusWarnBrush}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0,26,0,11" Text="{svc:T home.quickAccess}" />
                <!--
                    Cards in the style of a VMS start page: a full-colour tile, an isometric picture in the middle
                    and the page name underneath. The pictures are drawn in code (IsoArt), so they stay sharp at
                    any DPI and there is no image file to ship. The column count follows the page width.
                -->
                <UniformGrid x:Name="CardGrid" Columns="3" Margin="0,0,-10,0">
                    <Button x:Name="WallCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T shell.navWall}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2F6FD6" Offset="0"/><GradientStop Color="#1E4FA8" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="WallArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T shell.navWall}"/>
                            <TextBlock x:Name="WallState" Grid.Row="2" Style="{StaticResource CardState}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PlaybackCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T shell.navPlayback}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#6A5BD8" Offset="0"/><GradientStop Color="#4B3DAA" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="PlaybackArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T shell.navPlayback}"/>
                            <TextBlock x:Name="PlaybackState" Grid.Row="2" Style="{StaticResource CardState}" Text="{svc:T home.playbackState}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MapCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T shell.navMap}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1FA7A0" Offset="0"/><GradientStop Color="#127C78" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="MapArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T shell.navMap}"/>
                            <TextBlock x:Name="MapState" Grid.Row="2" Style="{StaticResource CardState}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="EventsCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T shell.navEvents}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9545A" Offset="0"/><GradientStop Color="#A83A42" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="EventsArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T shell.navEvents}"/>
                            <TextBlock x:Name="EventsState" Grid.Row="2" Style="{StaticResource CardState}" Text="{svc:T home.eventsState}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DevicesCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T shell.navDetail}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4C7FAF" Offset="0"/><GradientStop Color="#355E86" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="DevicesArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T shell.navDetail}"/>
                            <TextBlock x:Name="DevicesState" Grid.Row="2" Style="{StaticResource CardState}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DiagnosticsCard" Style="{StaticResource LandingCard}" Margin="0,0,10,10" Padding="16,14" Height="236"
                            AutomationProperties.Name="{svc:T home.diagnostics}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2E9E6A" Offset="0"/><GradientStop Color="#1E7550" Offset="1"/></LinearGradientBrush>
                        </Button.Background>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl x:Name="DiagnosticsArt" Margin="10,4,10,10" Focusable="False"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardTitle}" Text="{svc:T home.diagnostics}"/>
                            <TextBlock x:Name="DiagnosticsState" Grid.Row="2" Style="{StaticResource CardState}" Text="{svc:T home.diagnosticsState}"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="20,22">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T home.overview}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="19" Margin="0,5,0,0"
                               Text="{svc:T home.cameraHealth}" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,17,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.total}" />
                                <TextBlock x:Name="TotalFigure" FontFamily="{StaticResource DisplayFont}" FontSize="27"
                                           FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.online}" />
                                <TextBlock x:Name="OnlineFigure" FontFamily="{StaticResource DisplayFont}" FontSize="27"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,16,0,17">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.offline}" />
                                <TextBlock x:Name="OfflineFigure" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusCritBrush}" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelText}" Text="{svc:T home.other}" />
                                <TextBlock x:Name="OtherFigure" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{DynamicResource StatusWarnBrush}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource EyebrowText}" Margin="0,22,0,0" Text="{svc:T home.activity}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="16" Margin="0,5,0,0" Text="{svc:T home.events}" />
                    <TextBlock x:Name="FeedSub" Style="{StaticResource LabelText}" Margin="0,4,0,0" />
                    <ItemsControl x:Name="EventList" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="32" CornerRadius="2" Background="{Binding Accent}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,5,0">
                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Camera}" />
                                        <TextBlock Style="{StaticResource LabelText}" FontSize="10.5" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="10" Text="{Binding At}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyFeed" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                               Margin="0,12,0,4" Text="{svc:T home.noEvents}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
