<Window x:Class="SurveillanceGateway.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services"
        Title="{svc:T settings.title}" Icon="/Assets/app.ico"
        Width="510" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SideBgBrush}" Padding="26,23">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandYellowBrush}" Text="{svc:T settings.preferences}" />
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"
                           Foreground="White" Margin="0,5,0,0" Text="{svc:T settings.title}" />
                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#B7C3BA"
                           Margin="0,4,0,0" Text="{svc:T settings.subtitle}" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="22,20,22,22">
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T settings.preferences}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,15,0,7"
                               Text="{svc:T settings.language}" />
                    <ComboBox x:Name="LanguageBox" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="ไทย" Tag="th" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,17,0,8"
                               Text="{svc:T settings.theme}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="DarkRadio" Grid.Column="0" GroupName="Theme"
                                     Style="{StaticResource SettingsChoice}" Margin="0,0,5,0"
                                     Content="{svc:T settings.themeDark}" />
                        <RadioButton x:Name="LightRadio" Grid.Column="1" GroupName="Theme"
                                     Style="{StaticResource SettingsChoice}" Margin="5,0,0,0"
                                     Content="{svc:T settings.themeLight}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T settings.connection}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,14,0,0"
                               Text="{svc:T settings.gateway}" />
                    <TextBlock x:Name="GatewayText" Style="{StaticResource MonoText}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,15" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Text="{svc:T settings.version}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource MonoText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Content="{svc:T settings.checkUpdate}" />
                    </Grid>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource LabelText}" Margin="0,9,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource LabelText}" Margin="3,14,3,0"
                       Text="{svc:T settings.note}" />
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Margin="0,18,0,0" Content="{svc:T settings.close}" />
        </StackPanel>
    </Grid>
</Window>
