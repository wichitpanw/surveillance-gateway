<Window x:Class="SurveillanceGateway.Client.Views.EventDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services"
        Width="1000"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <!--
        One AI event, opened by clicking its row on the AI events page - the same popup the web
        console shows (src/components/modals/AiEventDialog.jsx): the full snapshot, the details,
        and previous/next through the list with the arrow keys. Esc or the close button shuts it.

        Same card style as ConfirmDialog. Transparency is fine: nothing here is an HWND.
    -->
    <Border Margin="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPanel}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Grid Margin="20,14,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" CornerRadius="1"
                            Background="{DynamicResource BrandYellowBrush}" />
                    <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        IsCancel="True" Content="{svc:T events.detail.close}" />
            </Grid>

            <Grid Background="#000000" Height="540">
                <Image x:Name="SnapshotImage" Stretch="Uniform" />
                <TextBlock x:Name="SnapshotText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#99FFFFFF" />
                <Button x:Name="PrevButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="12,0,0,0" Content="‹" FontSize="20" Padding="12,4"
                        ToolTip="{svc:T events.detail.prev}" />
                <Button x:Name="NextButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" Content="›" FontSize="20" Padding="12,4"
                        ToolTip="{svc:T events.detail.next}" />
            </Grid>

            <Grid Margin="20,14,20,16">
                <WrapPanel x:Name="FieldPanel" Margin="0,0,120,0" />
                <TextBlock x:Name="PositionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        <StackPanel Orientation="Horizontal" Margin="20,0,20,16"><Button x:Name="LiveButton" Style="{StaticResource GhostButton}" Content="{svc:T investigation.live}"/><Button x:Name="PlaybackButton" Style="{StaticResource GhostButton}" Content="{svc:T investigation.playback}" Margin="8,0"/></StackPanel>
        </StackPanel></ScrollViewer>
    </Border>
</Window>
