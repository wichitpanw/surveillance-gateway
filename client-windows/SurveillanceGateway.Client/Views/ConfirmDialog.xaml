<Window x:Class="SurveillanceGateway.Client.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}">
    <!--
        The app's own confirmation, in place of MessageBox.

        MessageBox is drawn by Windows in the system style - grey face, blue question icon - and
        sat in the middle of this dark UI like a leftover from another program. This one uses the
        same tokens as the rest of the client and the web consoles' dialogs.

        AllowsTransparency is fine here, unlike on the main window: nothing in this window is an
        HWND (no video, no WebView2), which is what transparency breaks.
    -->
    <Border Margin="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPanel}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="22,20,22,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Accent"
                            Width="4" Height="18"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            CornerRadius="1"
                            Background="{DynamicResource BrandYellowBrush}" />
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               TextWrapping="Wrap"
                               Text="" />
                </StackPanel>
                <TextBlock x:Name="MessageText"
                           Margin="14,12,0,0"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Text="" />
            </StackPanel>

            <Border Margin="0,20,0,0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MutedBrush}"
                    CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource GhostButton}"
                            IsCancel="True"
                            Content="{svc:T dialog.cancel}" />
                    <Button x:Name="OkButton"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            IsDefault="True"
                            Content="{svc:T dialog.ok}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
