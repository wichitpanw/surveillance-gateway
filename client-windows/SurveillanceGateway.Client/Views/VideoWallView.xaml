<UserControl x:Class="SurveillanceGateway.Client.Views.VideoWallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SurveillanceGateway.Client.Views"
             xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services">
    <UserControl.Resources>
        <views:StatusDotConverter x:Key="StatusDot" />
        <Style x:Key="WallControlsToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PickerColumn" Width="270" MinWidth="240" MaxWidth="420" />
            <ColumnDefinition x:Name="PickerDividerColumn" Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Camera picker. Its list scrolls; the wall beside it must not. -->
        <Border x:Name="PickerPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="12,12,0,12" Padding="12,14,8,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,6,10">
                    <Grid>
                        <ToggleButton x:Name="LibraryControls" Style="{StaticResource WallControlsToggle}" IsChecked="True"
                                      Margin="0,0,65,0" ToolTip="{svc:T wall.toggleFilters}"
                                      AutomationProperties.Name="{svc:T wall.toggleFilters}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="10" Height="6" Stretch="Uniform" Margin="0,0,6,0"
                                      Stroke="{DynamicResource MutedForegroundBrush}" StrokeThickness="1.5">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M2 1 L6 5 L10 1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LibraryControls}" Value="True">
                                                    <Setter Property="Data" Value="M2 5 L6 1 L10 5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Style="{StaticResource EyebrowText}" VerticalAlignment="Center"
                                           Text="{svc:T wall.library}" />
                            </StackPanel>
                        </ToggleButton>
                        <!-- A camera added at Central appears here without restarting the client. -->
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                Padding="9,4"
                                FontSize="11.5"
                                Content="{svc:T wall.reload}" />
                    </Grid>
                    <!-- Two ways to narrow the same list: pick a group, or type. A site with
                         forty cameras needs the first; one camera whose name you know needs the
                         second. -->
                    <!-- หุบเฉพาะสรุป/ค้นหา/ตัวกรอง โดยคงค่าที่เลือกและพื้นที่รายการกล้องไว้ -->
                    <StackPanel x:Name="LibraryFilters">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LibraryControls}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock x:Name="ScopeText" Style="{StaticResource MonoText}" Margin="2,8,0,0" Text="" />
                        <WrapPanel Margin="2,5,0,0">
                            <TextBlock x:Name="OnlineCountText" Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource StatusOkBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="OfflineCountText" Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource StatusCritBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="OtherCountText" Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource FaintForegroundBrush}" />
                        </WrapPanel>
                        <Grid Margin="0,12,0,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource FieldInput}" />
                            <TextBlock x:Name="SearchHint"
                                       Style="{StaticResource LabelText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource FaintForegroundBrush}"
                                       Text="{svc:T wall.search}" />
                        </Grid>
                        <ComboBox x:Name="GroupBox" Style="{StaticResource FieldCombo}"
                                  Margin="0,8,0,0" Tag="{svc:T wall.allGroups}" />
                        <ComboBox x:Name="StatusBox" Style="{StaticResource FieldCombo}" Margin="0,8,0,0" />
                        <CheckBox x:Name="FavoritesOnlyBox" Margin="2,10,0,0"
                                  Foreground="{DynamicResource MutedForegroundBrush}"
                                  Content="{svc:T wall.favorites}" />
                    </StackPanel>
                    <StackPanel Margin="0,13,0,0">
                            <TextBlock Style="{StaticResource EyebrowText}" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{svc:T wall.layout}" />
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="3"
                                    HorizontalAlignment="Left" Margin="0,6,0,0">
                                <StackPanel x:Name="LayoutSegments" Orientation="Horizontal" />
                            </Border>
                            <TextBlock Style="{StaticResource EyebrowText}" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,10,0,0"
                                       Text="{svc:T wall.stream}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusControl}" Padding="3"
                                        HorizontalAlignment="Left">
                                    <StackPanel x:Name="StreamSegments" Orientation="Horizontal" />
                                </Border>
                                <Button x:Name="ClearAllButton" Grid.Column="1"
                                        Style="{StaticResource GhostButton}" FontSize="10.5"
                                        Padding="7,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="6,0,0,0" Content="{svc:T wall.clearAll}" />
                            </Grid>
                    </StackPanel>
                </StackPanel>

                <!--
                    Grouped by the camera group the gateway already reports, and collapsible.
                    A key scoped to several sites lists cameras from all of them, and a flat list
                    of that makes an operator read every row to find one site.
                -->
                <ListBox x:Name="CameraList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="False"
                                                          Tag="CameraGroup"
                                                          Loaded="OnCameraGroupLoaded"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Margin="0,4,0,2">
                                                <Expander.Header>
                                                    <Grid Width="190">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Style="{StaticResource EyebrowText}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Tag="GroupRatio"
                                                                   Style="{StaticResource MonoText}" Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FaintForegroundBrush}" />
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource IconButton}"
                                                                Width="22" Height="22" Margin="4,0,0,0"
                                                                Tag="{Binding Name}" Click="OnPlayGroup"
                                                                ToolTip="{svc:T wall.playGroup}">
                                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                                                                  Data="M6 4 L18 12 L6 20 Z" />
                                                        </Button>
                                                    </Grid>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="0,4,0,0" />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,5,3" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusControl}"
                                                Padding="8,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MutedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MutedBrush}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                The dot is fed by the gateway's event stream, so it changes without
                                the list being reloaded. Grey means no event yet, not offline.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="7" Height="7"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Availability, Converter={StaticResource StatusDot}}"
                                         ToolTip="{Binding AvailabilityText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" Text="{Binding DisplayName}" />
                                    <TextBlock Style="{StaticResource LabelText}" FontSize="10.5"
                                               Foreground="{DynamicResource FaintForegroundBrush}"
                                               Text="{Binding AvailabilityText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Padding="4,0" Content="☆" Tag="{Binding}"
                                        Loaded="OnFavoriteLoaded" Click="OnFavoriteClick"
                                        ToolTip="{svc:T wall.favoriteAdd}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Margin="0,9,6,0" Padding="0,9,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ToggleButton x:Name="WallControls" Style="{StaticResource WallControlsToggle}" IsChecked="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Path Width="10" Height="6" Stretch="Uniform" StrokeThickness="1.4"
                                      Stroke="{DynamicResource ForegroundBrush}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M2 5 L6 1 L10 5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=WallControls}" Value="True">
                                                    <Setter Property="Data" Value="M2 1 L6 5 L10 1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>
                            <TextBlock Style="{StaticResource EyebrowText}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Text="{svc:T wall.controls}" />
                        </StackPanel>
                    </ToggleButton>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=WallControls}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="0,8,4,3">
                            <TextBlock Style="{StaticResource EyebrowText}" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{svc:T wall.view}" />
                            <Border x:Name="ViewChip" Visibility="Collapsed" Margin="0,6,0,0"
                                    Background="{DynamicResource BrandYellowSoftBrush}"
                                    BorderBrush="{DynamicResource BrandYellowLineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusPill}" Padding="8,4">
                                <TextBlock x:Name="ViewChipText" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource BrandYellowTextBrush}" />
                            </Border>
                            <ComboBox x:Name="ViewBox" Style="{StaticResource FieldCombo}"
                                      Margin="0,6,0,0" Tag="{svc:T wall.noViews}" />
                            <Grid Margin="0,7,0,0">
                                <TextBox x:Name="ViewNameBox" Style="{StaticResource FieldInput}"
                                         ToolTip="{svc:T wall.viewName}" />
                                <TextBlock x:Name="ViewNameHint" Style="{StaticResource LabelText}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Foreground="{DynamicResource FaintForegroundBrush}"
                                           Text="{svc:T wall.viewName}" />
                            </Grid>
                            <Button x:Name="SaveViewButton" Style="{StaticResource GhostButton}"
                                    Margin="0,7,0,0" Content="{svc:T wall.saveView}" />
                            <Button x:Name="DeleteViewButton" Style="{StaticResource GhostButton}"
                                    Margin="0,6,0,0" Content="{svc:T wall.deleteView}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter x:Name="PickerSplitter" Grid.Column="1"
                      Width="4"
                      Margin="2,12,0,12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource BorderBrush}" />
        <Grid x:Name="WallArea" Grid.Column="2" Margin="12,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                The wall sits in a panel too, with the cells inset from its edge. The cells are
                HWNDs and cannot be rounded themselves, so the panel is what gives the grid the
                same edge as everything else on the page.

                A fixed UniformGrid, never a ScrollViewer: an HWND does not clip to a scroll
                viewport, so a scrolled tile would paint straight over the surrounding UI.
                Layouts change the grid, they never make it scroll.
            -->
            <Grid x:Name="WallStage" Grid.Row="1">
            <Border x:Name="WallPanel" Style="{StaticResource Card}" Padding="7"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="FocusPtzColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="WallViewport" Grid.Column="0" Background="{DynamicResource VideoGroundBrush}">
                        <UniformGrid x:Name="Wall" Rows="3" Columns="3"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="FocusPtzPanel" Grid.Column="1" Margin="8,0,0,0" Padding="10"
                            Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T ptz.title}" />
                                <TextBlock Style="{StaticResource LabelText}" Margin="0,6,0,12"
                                           TextWrapping="Wrap" Text="{svc:T ptz.hold}" />
                                <UniformGrid x:Name="FocusPad" Rows="3" Columns="3">
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="-1,1,0" ToolTip="{svc:T ptz.upLeft}" Content="↖" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="0,1,0" ToolTip="{svc:T ptz.up}" Content="↑" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="1,1,0" ToolTip="{svc:T ptz.upRight}" Content="↗" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="-1,0,0" ToolTip="{svc:T ptz.left}" Content="←" />
                                    <Button x:Name="FocusHomeButton" Style="{StaticResource GhostButton}" Height="34" Margin="2" Content="⌂" ToolTip="{svc:T ptz.home}" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="1,0,0" ToolTip="{svc:T ptz.right}" Content="→" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="-1,-1,0" ToolTip="{svc:T ptz.downLeft}" Content="↙" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="0,-1,0" ToolTip="{svc:T ptz.down}" Content="↓" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="2" Tag="1,-1,0" ToolTip="{svc:T ptz.downRight}" Content="↘" />
                                </UniformGrid>
                                <StackPanel x:Name="FocusZoom" Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource LabelText}" VerticalAlignment="Center" Text="{svc:T ptz.zoom}" />
                                    <Button Style="{StaticResource GhostButton}" Width="40" Height="34" Margin="8,0,2,0" Tag="0,0,-1" ToolTip="{svc:T ptz.zoomOut}" Content="−" />
                                    <Button Style="{StaticResource GhostButton}" Width="40" Height="34" Margin="2,0" Tag="0,0,1" ToolTip="{svc:T ptz.zoomIn}" Content="+" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,4" Text="{svc:T ptz.speed}" />
                                <Slider x:Name="FocusSpeed" Minimum="0.1" Maximum="1" Value="0.5" />
                                <StackPanel x:Name="FocusPresetSection" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T ptz.presets}" />
                                    <ComboBox x:Name="FocusPresetBox" Style="{StaticResource FieldCombo}" Margin="0,6,0,0" />
                                    <Button x:Name="FocusPresetGo" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                            Content="{svc:T ptz.go}" />
                                </StackPanel>
                                <TextBlock x:Name="FocusPtzStatus" Style="{StaticResource LabelText}" Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <Border x:Name="FocusToolbar" Grid.Row="0" Style="{StaticResource Card}"
                    Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FocusBackButton" Style="{StaticResource GhostButton}"
                                Content="{svc:T wall.backToWall}" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T wall.focus}" />
                            <TextBlock x:Name="FocusCameraNameText" Style="{StaticResource HeadingText}"
                                       FontSize="15" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="FocusCameraStateText" Style="{StaticResource MonoText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
            </Border>

            <!--
                Pages, not a bigger grid. Asking for a group of eighty-five used to grow the wall
                to twenty-five cells and drop the other sixty; the layout is a decision about how
                much of the screen one camera gets, and it should not be overruled by how many
                cameras were asked for. Only the page on screen holds a decoder, so a wall of ten
                pages costs exactly what one page costs.
            -->
            <StackPanel Grid.Row="2"
                        x:Name="PageBar"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                <Button x:Name="PrevPageButton"
                        Style="{StaticResource GhostButton}"
                        Padding="12,4"
                        Content="◀"
                        ToolTip="{svc:T wall.prevPage}" />
                <TextBlock x:Name="PageText"
                           Style="{StaticResource MonoText}"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           Text="" />
                <Button x:Name="NextPageButton"
                        Style="{StaticResource GhostButton}"
                        Padding="12,4"
                        Content="▶"
                        ToolTip="{svc:T wall.nextPage}" />
                <Button x:Name="CycleButton" Style="{StaticResource GhostButton}"
                        Margin="12,0,0,0" Padding="10,4"
                        Content="{svc:T wall.cycleStart}" />
                <ComboBox x:Name="CycleSecondsBox" Style="{StaticResource FieldCombo}"
                          Width="78" Margin="6,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Grid.Row="3"
                       Style="{StaticResource MonoText}"
                       Margin="4,10,0,0"
                       Text="{svc:T wall.hint}" />
        </Grid>
    </Grid>
</UserControl>
