<Window x:Class="SurveillanceGateway.Client.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:video="clr-namespace:SurveillanceGateway.Client.Video"
        xmlns:svc="clr-namespace:SurveillanceGateway.Client.Services"
        Width="960" Height="580"
        Icon="/Assets/app.ico"
        MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <!--
        A window per camera, so several can be watched at once and each can be dragged to its own
        monitor. It also solves the map: nothing can be drawn over a WebView2, so a picture "on"
        the map has to be a window of its own.

        The title bar is drawn here rather than by Windows. The system one is a grey slab with
        square corners that the rest of this app has nothing in common with, and it wasted a whole
        row above a second row of our own controls - the camera name, the stream switch and the
        window buttons now share one bar.

        WindowChrome, not AllowsTransparency. Transparency would let the corners be rounded in WPF
        but it also drops the window to software rendering, which is fatal for a video surface;
        WindowChrome keeps the real window - snapping, resize edges, Aero Snap, taskbar previews -
        and only replaces what is painted in the caption. Rounded corners come from DWM instead,
        where the OS offers them (see the code-behind).

        One control on the bar, and only because sub and main are genuinely different pictures.
        The transcode checkbox that used to sit here was a developer's switch: the client already
        prefers the untranscoded path, steps down on its own when a camera cannot deliver it, and
        the picture's own chip says which one it ended up on. The PTZ toggle beside it appears
        only for a camera that turns, on a key allowed to turn it.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CaptionRow" Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Caption" Grid.Row="0" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Name and live state. The dot repeats what the picture's own caption says,
                     because this bar is what stays visible when the window is behind another. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot"
                             Width="7" Height="7"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource FaintForegroundBrush}" />
                    <TextBlock x:Name="TitleText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Text="" />
                </StackPanel>

                <!-- Hidden until the gateway says this camera turns and this key may turn it. -->
                <ToggleButton x:Name="PtzButton"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Style="{StaticResource SegmentButton}"
                              MinWidth="52"
                              Padding="9,4"
                              Visibility="Collapsed"
                              ToolTip="{svc:T ptz.toggle}"
                              Content="{svc:T ptz.title}" />

                <!-- Everything a person can click has to opt out of the caption, or the chrome
                     swallows the click and drags the window instead. -->
                <Border Grid.Column="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        VerticalAlignment="Center"
                        Margin="14,0,10,0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="SubButton"
                                      Style="{StaticResource SegmentButton}"
                                      MinWidth="52"
                                      Padding="9,4"
                                      IsChecked="True"
                                      Content="{svc:T player.sub}" />
                        <ToggleButton x:Name="MainButton"
                                      Style="{StaticResource SegmentButton}"
                                      MinWidth="52"
                                      Padding="9,4"
                                      Content="{svc:T player.main}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="MinimiseButton"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="{svc:T player.minimise}">
                        <Path Style="{StaticResource CaptionIcon}" Data="M4 12 H16" />
                    </Button>
                    <Button x:Name="MaximiseButton"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="{svc:T player.maximise}">
                        <Path x:Name="MaximiseIcon"
                              Style="{StaticResource CaptionIcon}"
                              Data="M5 5 H15 V15 H5 Z" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CaptionCloseButton}"
                            ToolTip="{svc:T player.close}">
                        <Path Style="{StaticResource CaptionIcon}" Data="M5 5 L15 15 M15 5 L5 15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                Six pixels of margin, and they are not decoration: the video is a child HWND, and
                a child HWND swallows the hit-test that WindowChrome needs to report a resize
                edge. Run the picture to the window edge and the window can no longer be resized
                from three of its four sides.
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <video:VideoTile x:Name="Tile" Grid.Column="0" Margin="6,0,6,6" />

                <!--
                    PTZ controls beside the picture, never over it: the video is a child HWND and
                    WPF cannot draw on top of one. Buttons are pressed and held - down starts the
                    move, release (or losing the mouse) stops it, the way a joystick works.
                -->
                <Border x:Name="PtzPanel"
                        Grid.Column="1"
                        Width="212"
                        Margin="0,0,6,6"
                        Padding="14"
                        Visibility="Collapsed"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T ptz.title}" />
                            <TextBlock Margin="0,4,0,12"
                                       Style="{StaticResource BodyText}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Text="{svc:T ptz.hold}" />

                            <UniformGrid x:Name="PadGrid" Rows="3" Columns="3" Width="126" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="-1,1,0" ToolTip="{svc:T ptz.upLeft}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 11 L8 6 L12 11" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="0,1,0" ToolTip="{svc:T ptz.up}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 11 L8 6 L12 11" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="1,1,0" ToolTip="{svc:T ptz.upRight}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 11 L8 6 L12 11" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="-1,0,0" ToolTip="{svc:T ptz.left}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M11 4 L6 8 L11 12" />
                                </Button>
                                <Button x:Name="HomeButton" Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" ToolTip="{svc:T ptz.home}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M3 8 L8 3.5 L13 8 M5 7 V13 H11 V7" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="1,0,0" ToolTip="{svc:T ptz.right}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M5 4 L10 8 L5 12" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="-1,-1,0" ToolTip="{svc:T ptz.downLeft}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 11 L8 6 L12 11" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="-135" /></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="0,-1,0" ToolTip="{svc:T ptz.down}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 5 L8 10 L12 5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="2" Height="38" Tag="1,-1,0" ToolTip="{svc:T ptz.downRight}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 11 L8 6 L12 11" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="135" /></Path.RenderTransform>
                                    </Path>
                                </Button>
                            </UniformGrid>

                            <Grid x:Name="ZoomRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource LabelText}" Text="{svc:T ptz.zoom}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="0" Width="38" Height="34" Margin="2,0" Tag="0,0,-1" ToolTip="{svc:T ptz.zoomOut}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 8 H12" />
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="0" Width="38" Height="34" Margin="2,0,0,0" Tag="0,0,1" ToolTip="{svc:T ptz.zoomIn}">
                                    <Path Style="{StaticResource GlyphIcon}" Data="M4 8 H12 M8 4 V12" />
                                </Button>
                            </Grid>

                            <TextBlock Margin="0,12,0,4" Style="{StaticResource LabelText}" Text="{svc:T ptz.speed}" />
                            <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="1" Value="0.5" SmallChange="0.1" LargeChange="0.2" />

                            <StackPanel x:Name="PresetSection" Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource EyebrowText}" Text="{svc:T ptz.presets}" />
                                <ComboBox x:Name="PresetBox" Margin="0,8,0,0" Style="{StaticResource FieldCombo}" MaxDropDownHeight="320" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PresetGoButton" Grid.Column="0" Style="{StaticResource GhostButton}" Padding="8,6" Content="{svc:T ptz.go}" />
                                    <Button x:Name="PresetRemoveButton" Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,6" Content="{svc:T ptz.remove}" />
                                </Grid>
                                <TextBox x:Name="PresetNameBox" Margin="0,12,0,0" Style="{StaticResource FieldInput}" MaxLength="64" ToolTip="{svc:T ptz.newName}" />
                                <Button x:Name="PresetSaveButton" Margin="0,6,0,0" Style="{StaticResource GhostButton}" Padding="8,6" Content="{svc:T ptz.save}" />
                            </StackPanel>

                            <TextBlock x:Name="PtzStatus"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource BodyText}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
