<Window x:Class="SurveillanceGateway.VideoWallProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gateway — M1 video wall probe"
        Width="1600" Height="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">
    <!-- AllowsTransparency stays false: it silently disables hardware WebView2 and breaks VideoView. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Margin="12,10"
                   FontFamily="Consolas"
                   FontSize="13"
                   Foreground="#9FB3C8"
                   Text="starting…" />

        <!-- Fixed grid, never a ScrollViewer: a VideoView is an HWND and paints outside scroll bounds. -->
        <UniformGrid x:Name="Wall"
                     Grid.Row="1"
                     Rows="3"
                     Columns="3"
                     Margin="8" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="12,8"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="#627D98"
                   Text="" />
    </Grid>
</Window>
